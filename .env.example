# Jackson OS environment template — NAMES ONLY.
# Copy to .env (git-ignored) and fill locally. Never commit real values.
# Secrets (KEY/TOKEN/SECRET/PASSWORD) must stay blank here; tests enforce it.

# --- Local infrastructure (infra/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jackson
POSTGRES_USER=jackson
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0
# API connects as the least-privilege role `jackson_app` (row-level security applies).
DATABASE_URL=
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=

# --- Phase 03: auth (hosted provider, Clerk recommended; ADR-012) ---
# Issuer + JWKS are public values from the provider dashboard, not secrets.
AUTH_ISSUER=
AUTH_JWKS_URL=
# Optional: require this `aud` claim.
AUTH_AUDIENCE=
# Comma-separated origins allowed in the `azp` claim, e.g. the console URL.
AUTH_AUTHORIZED_PARTIES=
# Console-side keys, used when apps/console is built.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Phase 06: durable workflows (Postgres queue, ADR-016) ---
# Worker connects as the least-privilege role `jackson_worker`.
WORKER_DATABASE_URL=
WORKER_TENANT_CONCURRENCY=4

# --- Artifacts ---
# Local artifact store (phase 11); API and worker must share it. S3 replaces it at deploy.
ARTIFACT_DIR=./var/artifacts
# Optional: path to a Chromium binary for browser sessions (else Playwright's own)
BROWSER_EXECUTABLE=
# S3-compatible store (not used yet)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Phase 08: model providers (none connected yet; MOCK is used until set) ---
ANTHROPIC_API_KEY=
# Optional: force a provider (anthropic | openai | local | mock) and per-profile model
JACKSON_MODEL_PROVIDER=
JACKSON_MODEL_PLANNING=
# Monthly model spend cap per tenant, USD
MODEL_MONTHLY_BUDGET_USD=20
# OpenAI stays off until model AND prices are set (no model name is assumed)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=
# Local OpenAI-compatible server (Ollama, vLLM, LM Studio)
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=

# --- Connectors (all MOCK until owner authorizes) ---
# Shopify DEVELOPMENT store (phase 15). The store domain lives in the shopify.drafts grant
# config; only the token goes here.
SHOPIFY_ADMIN_API_TOKEN=
WHOP_API_KEY=
APIFY_API_TOKEN=
UPLOAD_POST_API_KEY=
ELEVENLABS_API_KEY=
FAL_API_KEY=

# --- Growth OS (Base44) import, later phase ---
BASE44_APP_ID=
BASE44_API_KEY=

# --- Phase 17: websites ---
# "dns" checks domain ownership for real (DNS-over-HTTPS); default is a labeled mock
SITE_DOMAIN_VERIFY=

# --- Phase 18: outreach ---
# Signs unsubscribe links (32+ random characters). Required before outreach is prepared.
UNSUBSCRIBE_SECRET=
# Public https address of the API (used in unsubscribe links)
PUBLIC_BASE_URL=

# --- Phase 20: security ---
# "production" turns on fail-closed start-up checks, HSTS, hides /docs, disables code.run_python
APP_ENV=development
MAX_REQUEST_BYTES=5242880
# Requests per minute per IP for the public unsubscribe page
PUBLIC_RATE_LIMIT=30
# Backup/restore scripts (infra/backup): schema-owner connections
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=

# --- Going online (docs/DEPLOY.md, ADR-031) ---
# On the host these are derived automatically from MIGRATION_DATABASE_URL, CLERK_PUBLISHABLE_KEY
# and the public domain; anything set explicitly wins.
# Persistent disk for artifacts + generated secrets
DATA_DIR=/data
# Optional overrides for the generated database passwords
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
# Make the first Clerk user the owner (email + Clerk user id user_...)
OWNER_EMAIL=
OWNER_AUTH_SUBJECT=

# --- Shopify: the owner's real store, drafts only (docs/CONNECTORS.md) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Social posting: Upload-Post (docs/CONNECTORS.md) ---
UPLOADPOST_API_KEY=
# Upload-Post profile name the social accounts are connected under
UPLOADPOST_USER=
# Email via Resend (ADR-035). Sender must be on your verified Resend domain.
RESEND_API_KEY=
RESEND_FROM=
# Signing secret of the Resend webhook (bounces/complaints -> opt-out + launch signals)
RESEND_WEBHOOK_SECRET=
