# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:3000
# Optional shared secret for /api/v1/*. If set, the dashboard needs the same value
# (it is used server-side by the Next.js proxy, never sent to the browser).
JAXON_API_TOKEN=

# --- Storage (docker compose sets these for containers) ---
DATABASE_URL=postgresql+asyncpg://jaxon:jaxon@localhost:5432/jaxon
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=jaxon

# --- Model provider (required for agent runs) ---
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-opus-5-5
MODEL_EFFORT=high                  # low | medium | high | xhigh | max
MODEL_MAX_TOKENS=16000
ANTHROPIC_REFUSAL_FALLBACK=true    # server-side refusal fallback (Anthropic beta)

# --- Agents / skills ---
AGENT_MAX_STEPS=12
SKILL_TIMEOUT_SECONDS=60
SKILL_PACKAGES=                    # extra python packages to scan for skills, comma separated

# --- Authorized web access for web.fetch_url / browser.page_text ---
# Empty = all outbound skill traffic denied. Subdomains of a listed domain are allowed.
ALLOWED_WEB_DOMAINS=
BROWSER_EXECUTABLE_PATH=

# --- Integrations (optional) ---
GITHUB_TOKEN=

# --- Dashboard (frontend) ---
JAXON_API_URL=http://localhost:8000
