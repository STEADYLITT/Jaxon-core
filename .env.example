# Jackson OS environment template — NAMES ONLY.
# Copy to .env (git-ignored) and fill locally. Never commit real values.
# Secrets (KEY/TOKEN/SECRET/PASSWORD) must stay blank here; tests enforce it.

# --- Local infrastructure (infra/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jackson
POSTGRES_USER=jackson
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Phase 03: auth ---
AUTH_SECRET=

# --- Phase 06: durable workflows ---
TEMPORAL_ADDRESS=

# --- Artifacts (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Phase 08: model providers (none connected yet) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Connectors (all MOCK until owner authorizes) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
WHOP_API_KEY=
APIFY_API_TOKEN=
UPLOAD_POST_API_KEY=
ELEVENLABS_API_KEY=
FAL_API_KEY=

# --- Growth OS (Base44) import, later phase ---
BASE44_APP_ID=
BASE44_API_KEY=
